@model List<HomePlant.Models.UserModel>

<h2>Users</h2>

<table class="table">

    <thead>

        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Status</th>
            <th></th>
        </tr>

    </thead>

    <tbody>

        @foreach (var user in Model)
        {
            <tr>

                <td>@user.FullName</td>

                <td>@user.Email</td>

                <td>@user.Status</td>

                <td>

                    @if (user.Status == "Active")
                    {
                        <a asp-action="Ban"
                           asp-route-id="@user.Id"
                           class="btn btn-danger">
                            Ban
                        </a>
                    }
                    else
                    {
                        <a asp-action="UnBan"
                           asp-route-id="@user.Id"
                           class="btn btn-success">
                            UnBan
                        </a>
                    }

                </td>

            </tr>
        }

    </tbody>

</table>
@model List<HomePlant.Models.PlantModel>

<h2>My Plants</h2>

<a asp-action="Create"
   class="btn btn-success mb-3">
    Add Plant
</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Location</th>
            <th>Status</th>
            <th width="200"></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nickname</td>
                <td>@item.Location</td>
                <td>@item.CurrentStatus</td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-primary">
                        View
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-danger">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>